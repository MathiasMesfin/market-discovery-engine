    "severity": "SEVERE"
  },
  "C_FINANCIAL_DISTRESS_OR_GOING_CONCERN_PROCESS": {
    "patterns": [
      "going\\s+concern|substantial\\s+doubt",
      "bankruptcy|chapter\\s+11|chapter\\s+7|insolven|liquidation",
      "debt\\s+restructur|restructuring\\s+(support|agreement|plan)",
