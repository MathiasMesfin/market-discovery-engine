{
  "A_ACCOUNTING_RESTATEMENT_OR_ERROR": {
    "patterns": [
      "re-?state(ment|d|s)?",
      "(cannot|should\\s+no\\s+longer)\\s+be\\s+relied\\s+upon|non-reliance",
      "accounting\\s+errors?|errors?\\s+in\\s+(the\\s+)?accounting",
      "errors?\\s+in\\s+(the\\s+)?(previously\\s+issued\\s+)?financial",
      "prior\\s+period\\s+(reclassification|error|adjustment|revision)",
      "correction\\s+of\\s+(an?\\s+|prior\\s+)?errors?|accounting\\s+irregularit",
      "revenue\\s+recognition\\s+errors?"
    ],
    "severity": "SEVERE"
  },
  "B_AUDIT_OR_INTERNAL_CONTROL": {
    "patterns": [
      "material\\s+weakness(es)?",
      "internal\\s+controls?\\s+(over\\s+financial\\s+reporting|deficienc|weakness)",
